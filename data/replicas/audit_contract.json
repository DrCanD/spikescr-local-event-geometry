  "protocol": {
    "decision_rules": {
      "familywise_alpha": 0.05,
      "final_trace_collapse": "supported iff final_trace_changed_count_preserved is greater than zero in both seeds",
      "hierarchy_integrity_gate": "PASS iff the complete panel has zero hierarchy, null-replay, post-hoc-gap, tie-reconstruction, and directional-partition violations in both seeds; any candidate mismatch aborts",
      "margin_adverse_association": "supported iff both pooled source-level Spearman rho values are negative and both one-sided within-label permutation p-values pass Holm correction at alpha=0.05",
      "paired_adverse_vulnerability": "descriptive paired clean-correct adverse-vulnerability agreement; no pass/fail threshold",
      "tie_aware_reconstruction_gate": "PASS iff tie-aware gap reconstruction has zero mismatch; enforced fail-loud per candidate"
    },
    "design": "label-stratified sample without replacement from all 9981 SSC validation sources",
    "inference": "source-level summaries; within-label source bootstrap; within-label margin-association permutation; Wilson intervals and paired source tests are descriptive",
    "models": "two frozen count-readout replicas (protocol fixed before the audit)",
    "multiple_testing": "Holm correction across the two seed-level margin-association permutation tests only",
    "neighborhood": "all unique one-count moves to an adjacent native 10 ms bin; channel and 100-bin horizon preserved",
    "primary_hypotheses": [
      "Integrity gate: the exact trace-to-final-trace-to-count-to-class hierarchy, null replay, post-hoc gap bound, directional partition, and tie-aware reconstruction all pass in both seeds",
      "Final-trace collapse: non-zero final-layer-trace changes erased by the integer readout occur in both seeds",
      "Margin-adverse association: among clean-correct sources, clean top-two margin is negatively associated with exact adverse-T3 rate in each seed"
    ],
    "secondary_hypotheses": [
      "Paired adverse vulnerability: source vulnerability and directional T3 taxonomy are stable enough to report paired seed agreement",
      "Tie-aware reconstruction gate: the post-perturbation tie-aware gap identity reconstructs every class transition exactly"
    ],
    "selection_is_outcome_independent": true,
    "statistical_unit": "source example; candidates are nested measurements, never iid replicates",
    "test_policy": "this protocol uses ssc_valid.h5 only; ssc_test.h5 is not searched, opened, hashed, or evaluated"
  },
  "readout": "global+four-window exact integer final-layer spike counts",
